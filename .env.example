# Pollar (testnet app from Dashboard)
NEXT_PUBLIC_POLLAR_PUBLISHABLE_KEY=pub_testnet_xxxxxxxx
POLLAR_SECRET_KEY=sec_testnet_xxxxxxxx
POLLAR_SERVER_URL=https://server.api.pollar.xyz

# Network (any of these names work)
STELLAR_NETWORK=testnet
NEXT_PUBLIC_STELLAR_NETWORK=testnet
NEXT_PUBLIC_NETWORK=testnet

# UPEER session (min 32 chars; optional in dev — auto fallback)
UPEER_SESSION_SECRET=

# Supabase — hosted OR local `supabase start`
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=
# Local only: DB URL infers API at http://127.0.0.1:54321 when service role is set
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Reflector Pulse (LATAM FX on testnet)
REFLECTOR_PUBLIC_KEY=G...
REFLECTOR_RPC_URL=https://soroban-testnet.stellar.org
# Testnet FX (COP, MXN, …): CCSSOHTBL3LEWUCBBEB5NJFC2OKFRC74OWEIJIZLRJBGAAU4VMU5NV4W
# Mainnet Pubnet DEX (XLM SAC, …): CALI2BYU2JE6WVRUFYTS6MSBNEHGJ35P4AVCZYF3B6QOE3QKOB2PLE6M + mainnet RPC/passphrase
REFLECTOR_PULSE_CONTRACT_ID=

# Trustless Work V1 testnet
TRUSTLESS_WORK_API_KEY=

# Escrow operator (G addresses — not Pollar)
UPEER_PLATFORM_ADDRESS=
UPEER_DEMO_MERCHANT_ADDRESS=
UPEER_PLATFORM_FEE_BPS=50
UPEER_OPERATOR_API_KEY=

# Soroswap
SOROSWAP_API_KEY=sk_...

STELLAR_MAINNET_RPC_URL=
